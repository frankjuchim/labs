# Beispiel – echte Werte nur in CapRover (App „labs“ → App Configs → Environment Variables), nie committen.
PORTAL_URL=https://labs.frankjuchim.de
ADMIN_EMAIL=admin
ADMIN_PASSWORD=bitte-langes-passwort
SESSION_SECRET=langer-zufallswert-mindestens-32-zeichen
# PORTAL_PRIVATE_KEY weglassen (empfohlen): das Portal erzeugt den Schlüssel selbst in DATA_DIR/portal-schluessel.pem.
# Optional eigener Schlüssel (Ed25519, kompakt oder PEM) aus: npm run schluessel
# PORTAL_PRIVATE_KEY=MC4CAQAw...
# optional: PORT=80, DATA_DIR=/app/data, TRUST_PROXY=1
